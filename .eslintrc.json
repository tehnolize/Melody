{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error",
          "log"
        ]
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-param-reassign": [
      "warn",
      {
        "props": false
      }
    ],
    "import/extensions": [
      "warn",
      "ignorePackages"
    ],
    "import/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": [
          "**/*.test.js",
          "**/*.spec.js",
          "**/tests/**",
          "**/test/**",
          "jest.config.js"
        ]
      }
    ],
    "import/prefer-default-export": "warn",
    "import/no-unresolved": [
      "error",
      {
        "ignore": [
          "nodemailer",
          "openai",
          "cookie-parser"
        ]
      }
    ],
    "consistent-return": "warn",
    "no-underscore-dangle": "off",
    "func-names": "off",
    "no-throw-literal": "warn",
    "max-len": [
      "warn",
      {
        "code": 120,
        "ignoreComments": true,
        "ignoreUrls": true,
        "ignoreStrings": true
      }
    ],
    "no-await-in-loop": "warn",
    "no-restricted-syntax": "warn",
    "no-continue": "warn",
    "no-plusplus": "warn",
    "no-control-regex": "warn",
    "no-cond-assign": "warn",
    "no-use-before-define": [
      "error",
      {
        "functions": false,
        "classes": false
      }
    ],
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": [
        "*.test.js",
        "*.spec.js"
      ],
      "env": {
        "jest": true
      }
    }
  ]
}
