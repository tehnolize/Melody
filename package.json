{
  "name": "melody",
  "version": "1.0.0",
  "description": "Музыкальный веб-сервис для прослушивания музыки, управления плейлистами и персонализации контента",
  "main": "landing/server/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon landing/server/index.js",
    "start": "node landing/server/index.js",
    "migrate": "node landing/server/db/migrations/run.js",
    "migrate:undo": "node landing/server/db/migrations/rollback.js",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testMatch='**/*.integration.test.js'",
    "test:auth": "jest --testMatch='**/*.auth.test.js'",
    "lint": "eslint landing/server --fix --max-warnings=100",
    "lint:check": "eslint landing/server",
    "lint:strict": "eslint landing/server --max-warnings=0",
    "format": "prettier --write \"landing/server/**/*.js\"",
    "format:check": "prettier --check \"landing/server/**/*.js\""
  },
  "keywords": [
    "music",
    "streaming",
    "playlist",
    "audio"
  ],
  "author": "Teknolize Team",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "openai": "^4.24.0",
    "pg": "^8.11.0",
    "pino": "^8.16.1",
    "pino-http": "^8.5.0",
    "sequelize": "^6.35.0",
    "uuid": "^9.0.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
